			"referenceName": "ls_adls_healthlake",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"datasetNam": {
				"type": "string"
			},
			"odate": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(dataset().datasetName, '.csv')",
