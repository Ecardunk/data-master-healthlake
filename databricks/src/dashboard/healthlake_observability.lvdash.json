{
  "datasets": [
    {
      "displayName": "Latest successful HealthLake jobs",
      "name": "a1b2c3d4",
      "query": "WITH current_jobs AS (\n  SELECT workspace_id, job_id, name, delete_time\n  FROM system.lakeflow.jobs\n  WHERE workspace_id = CASE current_catalog()\n    WHEN 'healthlake_dev' THEN '7405611974072786'\n    WHEN 'healthlake_prod' THEN '7405616424934600'\n  END\n  QUALIFY ROW_NUMBER() OVER (PARTITION BY workspace_id, job_id ORDER BY change_time DESC) = 1\n), latest_success AS (\n  SELECT workspace_id, job_id, MAX(period_end_time) AS last_success_at\n  FROM system.lakeflow.job_run_timeline\n  WHERE result_state = 'SUCCEEDED'\n  GROUP BY workspace_id, job_id\n)\nSELECT j.name AS job_name, s.last_success_at\nFROM current_jobs j\nJOIN latest_success s USING (workspace_id, job_id)\nWHERE j.delete_time IS NULL AND j.name LIKE '%healthlake%'\nORDER BY s.last_success_at DESC"
    },
    {
      "displayName": "DQ results",
      "name": "b2c3d4e5",
      "query": "SELECT checked_at, dq_stage, source_table, quarantine_table, input_rows, valid_rows, quarantined_rows, status\nFROM dq_run_metrics\nORDER BY checked_at DESC"
    },
    {
      "displayName": "Quarantine summary",
      "name": "c3d4e5f6",
      "query": "SELECT source_table, dq_stage, quarantine_table, SUM(quarantined_rows) AS quarantined_rows, MAX(checked_at) AS last_quarantined_at\nFROM dq_run_metrics\nWHERE quarantined_rows > 0\nGROUP BY source_table, dq_stage, quarantine_table\nORDER BY last_quarantined_at DESC"
    }
  ],
